{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kicad-agent-suite.local/schema/circuit-model.v1.json",
  "title": "CircuitModel v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "topology",
    "components",
    "nets",
    "calculations",
    "design_decisions",
    "risks"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "circuit-model.v1"
    },
    "request_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "topology": {
      "type": "string"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "role",
          "value",
          "selected_part",
          "candidate_parts",
          "availability_status"
        ],
        "properties": {
          "ref": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "selected_part": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "part_id",
              "display_name"
            ],
            "properties": {
              "part_id": {
                "type": "string"
              },
              "display_name": {
                "type": "string"
              },
              "lcsc_id": {
                "type": "string"
              },
              "manufacturer": {
                "type": "string"
              },
              "mpn": {
                "type": "string"
              },
              "package": {
                "type": "string"
              },
              "mechanical_package": {
                "type": "string"
              },
              "kicad_footprint_hint": {
                "type": "string"
              },
              "library_uuid": {
                "type": "string"
              },
              "symbol_uuid": {
                "type": "string"
              },
              "pin_count": {
                "type": "integer"
              },
              "named_pin_count": {
                "type": "integer"
              }
            }
          },
          "candidate_parts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "part_id",
                "display_name"
              ],
              "properties": {
                "part_id": {
                  "type": "string"
                },
                "display_name": {
                  "type": "string"
                },
                "lcsc_id": {
                  "type": "string"
                },
                "manufacturer": {
                  "type": "string"
                },
                "mpn": {
                  "type": "string"
                },
                "package": {
                  "type": "string"
                },
                "mechanical_package": {
                  "type": "string"
                },
                "kicad_footprint_hint": {
                  "type": "string"
                },
                "library_uuid": {
                  "type": "string"
                },
                "symbol_uuid": {
                  "type": "string"
                },
                "pin_count": {
                  "type": "integer"
                },
                "named_pin_count": {
                  "type": "integer"
                }
              }
            }
          },
          "availability_status": {
            "type": "string",
            "enum": [
              "unknown",
              "available",
              "unavailable"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "search_hints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "nets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "members"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "members": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "calculations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "formula",
          "inputs",
          "result",
          "unit"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "formula": {
            "type": "string"
          },
          "inputs": {
            "type": "object"
          },
          "result": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          }
        }
      }
    },
    "design_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "rationale"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          }
        }
      }
    },
    "power_rails": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "name",
          "source_net"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "source_net": {
            "type": "string"
          },
          "voltage": {
            "type": "number"
          },
          "current_limit": {
            "type": "number"
          },
          "parent": {
            "type": "string"
          },
          "sequence_order": {
            "type": "integer"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "sheets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "components",
          "nets"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "components": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "nets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
