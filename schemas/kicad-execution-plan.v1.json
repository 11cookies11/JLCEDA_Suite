{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kicad-agent-suite.local/schema/kicad-execution-plan.v1.json",
  "title": "KiCadExecutionPlan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "target",
    "symbols",
    "nets",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "kicad-execution-plan.v1"
    },
    "request_id": {
      "type": "string"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_name",
        "output_dir"
      ],
      "properties": {
        "project_name": {
          "type": "string"
        },
        "output_dir": {
          "type": "string"
        },
        "schematic_file": {
          "type": "string"
        },
        "project_file": {
          "type": "string"
        }
      }
    },
    "symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "role",
          "value",
          "lib_id",
          "at",
          "pins"
        ],
        "properties": {
          "ref": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "lib_id": {
            "type": "string"
          },
          "footprint": {
            "type": "string"
          },
          "at": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y",
              "rotation"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "rotation": {
                "type": "number"
              }
            }
          },
          "pins": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "number",
                "name",
                "net"
              ],
              "properties": {
                "number": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "net": {
                  "type": "string"
                }
              }
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "nets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "members"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "signal",
              "power",
              "ground",
              "unknown"
            ]
          },
          "members": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warnings",
        "unsupported"
      ],
      "properties": {
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unsupported": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
