{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dsl-api-payloads.v1.json",
  "title": "DSL API Operation Payloads",
  "description": "Payload schemas for each supported circuit-model DSL API operation.",
  "$defs": {

    "common_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Component reference (e.g. U1, R100, TP11)."
    },
    "common_name": {
      "type": "string",
      "minLength": 1,
      "description": "Entity name (net, sheet, calculation, constraint, power rail)."
    },
    "common_key": {
      "type": "string",
      "minLength": 1,
      "description": "Risk key identifier."
    },
    "common_title": {
      "type": "string",
      "minLength": 1,
      "description": "Design decision title."
    },
    "common_value": {
      "description": "Value for set_* / mark_* field operations."
    },
    "common_patch": {
      "type": "object",
      "description": "Partial update payload merged into the target object."
    },
    "common_component": {
      "type": "object",
      "required": ["ref"],
      "properties": {
        "ref": { "$ref": "#/$defs/common_ref" },
        "role": { "type": "string" },
        "value": { "type": "string" },
        "selected_part": { "type": "object" },
        "candidate_parts": { "type": "array" },
        "availability_status": { "type": "string" },
        "notes": { "type": "array", "items": { "type": "string" } },
        "sheet": { "type": "string" },
        "search_hints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "common_net": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/common_name" },
        "members": { "type": "array", "items": { "type": "string" } },
        "kind": { "type": "string" },
        "notes": { "type": "array", "items": { "type": "string" } },
        "domain": { "type": "string" },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "flags": { "type": "object" }
      }
    },

    "add_component": {
      "type": "object",
      "required": ["ref"],
      "properties": {
        "ref": { "$ref": "#/$defs/common_ref" },
        "component": { "$ref": "#/$defs/common_component" },
        "role": { "type": "string" },
        "value": { "type": "string" },
        "selected_part": { "type": "object" },
        "candidate_parts": { "type": "array" },
        "availability_status": { "type": "string" },
        "notes": { "type": "array", "items": { "type": "string" } },
        "sheet": { "type": "string" },
        "pinmap": { "type": "object" },
        "search_hints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "update_component": {
      "type": "object",
      "required": ["ref", "patch"],
      "properties": {
        "ref": { "$ref": "#/$defs/common_ref" },
        "component": { "$ref": "#/$defs/common_component" },
        "patch": { "$ref": "#/$defs/common_patch" }
      }
    },
    "remove_component": {
      "type": "object",
      "required": ["ref"],
      "properties": {
        "ref": { "$ref": "#/$defs/common_ref" },
        "component": { "type": "string" }
      }
    },
    "get_component": {
      "type": "object",
      "required": ["ref"],
      "properties": {
        "ref": { "$ref": "#/$defs/common_ref" },
        "component": { "type": "string" }
      }
    },
    "set_selected_part": {
      "type": "object",
      "required": ["ref", "part"],
      "properties": {
        "ref": { "$ref": "#/$defs/common_ref" },
        "component": { "type": "string" },
        "part": { "type": "object" },
        "selected_part": { "type": "object" }
      }
    },
    "add_candidate_part": {
      "type": "object",
      "required": ["ref", "part"],
      "properties": {
        "ref": { "$ref": "#/$defs/common_ref" },
        "component": { "type": "string" },
        "part": { "type": "object" },
        "candidate_part": { "type": "object" }
      }
    },
    "remove_candidate_part": {
      "type": "object",
      "required": ["ref", "part_id"],
      "properties": {
        "ref": { "$ref": "#/$defs/common_ref" },
        "component": { "type": "string" },
        "part_id": { "type": "string" }
      }
    },
    "set_component_ref": {
      "type": "object",
      "required": ["ref", "value"],
      "properties": {
        "ref": { "$ref": "#/$defs/common_ref" },
        "value": { "type": "string" },
        "new_ref": { "type": "string" }
      }
    },
    "set_component_role": {
      "type": "object",
      "required": ["ref", "value"],
      "properties": {
        "ref": { "$ref": "#/$defs/common_ref" },
        "value": { "type": "string" },
        "role": { "type": "string" }
      }
    },
    "set_component_value": {
      "type": "object",
      "required": ["ref", "value"],
      "properties": {
        "ref": { "$ref": "#/$defs/common_ref" },
        "value": { "type": "string" }
      }
    },
    "set_component_notes": {
      "type": "object",
      "required": ["ref"],
      "properties": {
        "ref": { "$ref": "#/$defs/common_ref" },
        "value": { "type": "array" },
        "notes": { "type": "array" }
      }
    },
    "set_component_availability": {
      "type": "object",
      "required": ["ref", "value"],
      "properties": {
        "ref": { "$ref": "#/$defs/common_ref" },
        "value": { "type": "string" },
        "availability_status": { "type": "string" }
      }
    },
    "set_component_search_hints": {
      "type": "object",
      "required": ["ref", "value"],
      "properties": {
        "ref": { "$ref": "#/$defs/common_ref" },
        "value": { "type": "array", "items": { "type": "string" } },
        "search_hints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "mark_component_resolved": {
      "type": "object",
      "required": ["ref"],
      "properties": {
        "ref": { "$ref": "#/$defs/common_ref" }
      }
    },
    "mark_component_needs_review": {
      "type": "object",
      "required": ["ref"],
      "properties": {
        "ref": { "$ref": "#/$defs/common_ref" }
      }
    },
    "mark_component_blocked": {
      "type": "object",
      "required": ["ref"],
      "properties": {
        "ref": { "$ref": "#/$defs/common_ref" },
        "reason": { "type": "string" }
      }
    },
    "assign_component_to_sheet": {
      "type": "object",
      "required": ["ref", "sheet_name"],
      "properties": {
        "ref": { "$ref": "#/$defs/common_ref" },
        "sheet": { "type": "string" },
        "sheet_name": { "type": "string" }
      }
    },

    "add_net": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/common_name" },
        "net": { "$ref": "#/$defs/common_net" },
        "members": { "type": "array", "items": { "type": "string" } },
        "kind": { "type": "string" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "update_net": {
      "type": "object",
      "required": ["name", "patch"],
      "properties": {
        "name": { "$ref": "#/$defs/common_name" },
        "net": { "type": "string" },
        "patch": { "$ref": "#/$defs/common_patch" },
        "net_patch": { "$ref": "#/$defs/common_patch" }
      }
    },
    "remove_net": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/common_name" },
        "net": { "type": "string" }
      }
    },
    "get_net": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/common_name" },
        "net": { "type": "string" }
      }
    },
    "connect_member": {
      "type": "object",
      "required": ["net", "member"],
      "properties": {
        "net": { "type": "string" },
        "member": { "type": "string" }
      }
    },
    "disconnect_member": {
      "type": "object",
      "required": ["net", "member"],
      "properties": {
        "net": { "type": "string" },
        "member": { "type": "string" }
      }
    },
    "connect_members": {
      "type": "object",
      "required": ["net", "members"],
      "properties": {
        "net": { "type": "string" },
        "members": { "type": "array", "items": { "type": "string" } }
      }
    },
    "disconnect_members": {
      "type": "object",
      "required": ["net", "members"],
      "properties": {
        "net": { "type": "string" },
        "members": { "type": "array", "items": { "type": "string" } }
      }
    },
    "rename_net": {
      "type": "object",
      "required": ["old_name", "new_name"],
      "properties": {
        "name": { "type": "string" },
        "net": { "type": "string" },
        "old_name": { "type": "string" },
        "new_name": { "type": "string", "minLength": 1 }
      }
    },
    "merge_nets": {
      "type": "object",
      "required": ["source", "target"],
      "properties": {
        "source": { "type": "string" },
        "target": { "type": "string" }
      }
    },
    "split_net": {
      "type": "object",
      "required": ["name", "new_nets"],
      "properties": {
        "name": { "type": "string" },
        "net": { "type": "string" },
        "new_nets": { "type": "array", "items": { "type": "string" } },
        "new_names": { "type": "array", "items": { "type": "string" } }
      }
    },
    "set_net_kind": {
      "type": "object",
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string" },
        "net": { "type": "string" },
        "value": { "type": "string" },
        "kind": { "type": "string" }
      }
    },
    "set_net_notes": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "net": { "type": "string" },
        "value": { "type": "array" },
        "notes": { "type": "array" }
      }
    },
    "set_net_aliases": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "net": { "type": "string" },
        "value": { "type": "array" },
        "aliases": { "type": "array" }
      }
    },
    "set_net_domain": {
      "type": "object",
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string" },
        "net": { "type": "string" },
        "value": { "type": "string" },
        "domain": { "type": "string" }
      }
    },
    "mark_net_global": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "net": { "type": "string" }
      }
    },
    "mark_net_power": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "net": { "type": "string" }
      }
    },
    "mark_net_high_speed": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "net": { "type": "string" }
      }
    },
    "mark_net_debug": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "net": { "type": "string" }
      }
    },
    "mark_net_differential_pair": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "net": { "type": "string" }
      }
    },
    "assign_net_to_sheet": {
      "type": "object",
      "required": ["net_name", "sheet_name"],
      "properties": {
        "net_name": { "type": "string" },
        "sheet_name": { "type": "string" }
      }
    },

    "set_pinmap": {
      "type": "object",
      "required": ["ref", "pinmap"],
      "properties": {
        "ref": { "$ref": "#/$defs/common_ref" },
        "pinmap": { "type": "object" },
        "map": { "type": "object" }
      }
    },
    "update_pinmap": {
      "type": "object",
      "required": ["ref", "pinmap"],
      "properties": {
        "ref": { "$ref": "#/$defs/common_ref" },
        "pinmap": { "type": "object" },
        "map": { "type": "object" }
      }
    },
    "remove_pinmap": {
      "type": "object",
      "required": ["ref"],
      "properties": {
        "ref": { "$ref": "#/$defs/common_ref" }
      }
    },
    "get_pinmap": {
      "type": "object",
      "required": ["ref"],
      "properties": {
        "ref": { "$ref": "#/$defs/common_ref" }
      }
    },
    "connect_pin_to_net": {
      "type": "object",
      "required": ["ref", "pin", "net"],
      "properties": {
        "ref": { "$ref": "#/$defs/common_ref" },
        "pin": { "type": "string" },
        "net": { "type": "string" }
      }
    },
    "disconnect_pin_from_net": {
      "type": "object",
      "required": ["ref", "pin"],
      "properties": {
        "ref": { "$ref": "#/$defs/common_ref" },
        "pin": { "type": "string" },
        "net": { "type": "string" }
      }
    },
    "set_pin_name": {
      "type": "object",
      "required": ["ref", "pin"],
      "properties": {
        "ref": { "$ref": "#/$defs/common_ref" },
        "pin": { "type": "string" },
        "value": { "type": "string" }
      }
    },
    "set_pin_role": {
      "type": "object",
      "required": ["ref", "pin"],
      "properties": {
        "ref": { "$ref": "#/$defs/common_ref" },
        "pin": { "type": "string" },
        "value": { "type": "string" },
        "role": { "type": "string" }
      }
    },
    "set_pin_direction": {
      "type": "object",
      "required": ["ref", "pin"],
      "properties": {
        "ref": { "$ref": "#/$defs/common_ref" },
        "pin": { "type": "string" },
        "value": { "type": "string" },
        "direction": { "type": "string" }
      }
    },
    "set_pin_no_connect": {
      "type": "object",
      "required": ["ref", "pin"],
      "properties": {
        "ref": { "$ref": "#/$defs/common_ref" },
        "pin": { "type": "string" },
        "enabled": { "type": "boolean" }
      }
    },
    "add_pin_alias": {
      "type": "object",
      "required": ["ref", "pin", "alias"],
      "properties": {
        "ref": { "$ref": "#/$defs/common_ref" },
        "pin": { "type": "string" },
        "alias": { "type": "string" }
      }
    },
    "resolve_pin_alias": {
      "type": "object",
      "required": ["ref", "pin"],
      "properties": {
        "ref": { "$ref": "#/$defs/common_ref" },
        "pin": { "type": "string" },
        "alias": { "type": "string" }
      }
    },

    "add_power_rail": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "rail": { "type": "object" },
        "source_net": { "type": "string" },
        "voltage": { "type": "number" },
        "current_limit": { "type": "number" }
      }
    },
    "update_power_rail": {
      "type": "object",
      "required": ["name", "patch"],
      "properties": {
        "name": { "type": "string" },
        "rail": { "type": "string" },
        "patch": { "$ref": "#/$defs/common_patch" }
      }
    },
    "remove_power_rail": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "rail": { "type": "string" }
      }
    },
    "get_power_rail": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "rail": { "type": "string" }
      }
    },
    "set_rail_source": {
      "type": "object",
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string" },
        "rail": { "type": "string" },
        "value": { "type": "string" },
        "source_net": { "type": "string" }
      }
    },
    "set_rail_sink": {
      "type": "object",
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "string" },
        "sink_ref": { "type": "string" }
      }
    },
    "set_rail_parent": {
      "type": "object",
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "string" },
        "parent": { "type": "string" }
      }
    },
    "set_rail_children": {
      "type": "object",
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "array" },
        "children": { "type": "array" }
      }
    },
    "set_rail_voltage": {
      "type": "object",
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "number" },
        "voltage": { "type": "number" }
      }
    },
    "set_rail_current_limit": {
      "type": "object",
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "number" },
        "current_limit": { "type": "number" }
      }
    },
    "set_rail_sequence_order": {
      "type": "object",
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "integer" },
        "sequence_order": { "type": "integer" }
      }
    },
    "set_rail_enable_condition": {
      "type": "object",
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "string" },
        "enable_condition": { "type": "string" }
      }
    },
    "add_rail_test_point": {
      "type": "object",
      "required": ["name", "ref"],
      "properties": {
        "name": { "type": "string" },
        "rail": { "type": "string" },
        "ref": { "type": "string" }
      }
    },
    "bind_rail_to_test_point": {
      "type": "object",
      "required": ["name", "ref"],
      "properties": {
        "name": { "type": "string" },
        "ref": { "type": "string" }
      }
    },

    "add_sheet": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "sheet": { "type": "object" },
        "inputs": { "type": "array" },
        "outputs": { "type": "array" },
        "components": { "type": "array" },
        "nets": { "type": "array" }
      }
    },
    "update_sheet": {
      "type": "object",
      "required": ["name", "patch"],
      "properties": {
        "name": { "type": "string" },
        "sheet": { "type": "string" },
        "patch": { "$ref": "#/$defs/common_patch" }
      }
    },
    "remove_sheet": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "sheet": { "type": "string" }
      }
    },
    "get_sheet": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "sheet": { "type": "string" }
      }
    },
    "set_sheet_name": {
      "type": "object",
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "string" }
      }
    },
    "set_sheet_inputs": {
      "type": "object",
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "array" },
        "inputs": { "type": "array" }
      }
    },
    "set_sheet_outputs": {
      "type": "object",
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "array" },
        "outputs": { "type": "array" }
      }
    },
    "set_sheet_components": {
      "type": "object",
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "array" },
        "components": { "type": "array" }
      }
    },
    "set_sheet_nets": {
      "type": "object",
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "array" },
        "nets": { "type": "array" }
      }
    },
    "set_sheet_constraints": {
      "type": "object",
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "array" },
        "constraints": { "type": "array" }
      }
    },
    "set_sheet_notes": {
      "type": "object",
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "array" },
        "notes": { "type": "array" }
      }
    },

    "add_calculation": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "calculation": { "type": "object" },
        "formula": { "type": "string" },
        "inputs": { "type": "object" },
        "result": {},
        "unit": { "type": "string" }
      }
    },
    "update_calculation": {
      "type": "object",
      "required": ["name", "patch"],
      "properties": {
        "name": { "type": "string" },
        "calculation": { "type": "string" },
        "patch": { "$ref": "#/$defs/common_patch" }
      }
    },
    "remove_calculation": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "calculation": { "type": "string" }
      }
    },
    "get_calculation": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "calculation": { "type": "string" }
      }
    },
    "recompute_calculation": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "calculation": { "type": "string" }
      }
    },
    "set_calculation_formula": {
