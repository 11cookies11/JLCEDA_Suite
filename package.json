{
  "name": "kicad-agent-suite",
  "version": "0.2.0",
  "private": true,
  "description": "Agent-assisted KiCad hardware development pipeline.",
  "author": "KiCad Agent Suite contributors",
  "license": "MIT",
  "engines": {
    "node": ">=20.17.0"
  },
  "scripts": {
    "pipeline": "python3 ./scripts/server_eda_target.py",
    "text-to-kicad": "python3 ./scripts/server_text_to_kicad.py",
    "server:text-to-kicad": "python3 ./scripts/server_text_to_kicad.py",
    "server:text-to-eda": "python3 ./scripts/server_eda_target.py",
    "compile-plan": "python3 ./scripts/compile_kicad_execution_plan.py",
    "write-project": "python3 ./scripts/kicad_project_writer.py",
    "erc": "python3 ./scripts/kicad_erc_runner.py",
    "server:kicad:erc": "python3 ./scripts/kicad_erc_runner.py",
    "ngspice:regression": "python3 ./scripts/ngspice-regression-test.py",
    "jlc:list-tools": "node ./scripts/jlc_mcp_bridge.mjs list-tools",
    "jlc:search": "node ./scripts/jlc_mcp_bridge.mjs search",
    "jlc:install": "node ./scripts/jlc_mcp_bridge.mjs install",
    "jlc:fix": "node ./scripts/jlc_mcp_bridge.mjs fix"
  },
  "dependencies": {
    "@jlcpcb/mcp": "^0.3.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "elkjs": "^0.11.1"
  }
}
