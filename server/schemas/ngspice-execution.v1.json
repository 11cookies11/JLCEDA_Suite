{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jlceda-suite.local/schema/ngspice-execution.v1.json",
  "title": "NgspiceExecution v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "enabled",
    "attempted",
    "executable",
    "command",
    "netlist_path",
    "log_path",
    "success",
    "parsed",
    "warnings",
    "error"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ngspice-execution.v1"
    },
    "request_id": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "attempted": {
      "type": "boolean"
    },
    "executable": {
      "type": "string"
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "netlist_path": {
      "type": "string"
    },
    "log_path": {
      "type": "string"
    },
    "returncode": {
      "type": [
        "integer",
        "null"
      ]
    },
    "success": {
      "type": "boolean"
    },
    "stdout": {
      "type": "string"
    },
    "stderr": {
      "type": "string"
    },
    "log_text": {
      "type": "string"
    },
    "parsed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysisKinds",
        "warnings",
        "errors",
        "measurements",
        "scalarValues",
        "lineCount"
      ],
      "properties": {
        "analysisKinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "measurements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scalarValues": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "lineCount": {
          "type": "integer"
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "type": "string"
    }
  }
}
