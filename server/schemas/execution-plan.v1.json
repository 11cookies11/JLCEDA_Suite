{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jlceda-suite.local/schema/execution-plan.v1.json",
  "title": "ExecutionPlan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "target",
    "operations",
    "fallback_rules"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "execution-plan.v1"
    },
    "request_id": {
      "type": "string"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "active_document",
            "new_document"
          ]
        },
        "project_uuid": {
          "type": "string"
        },
        "schematic_uuid": {
          "type": "string"
        },
        "page_uuid": {
          "type": "string"
        }
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "payload"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "place_component",
              "create_wire",
              "annotate_net",
              "create_net_flag",
              "save",
              "inspect_connectivity",
              "check_drc"
            ]
          },
          "payload": {
            "type": "object"
          },
          "on_error": {
            "type": "string",
            "enum": [
              "continue",
              "stop"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "fallback_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trigger_code",
          "strategy"
        ],
        "properties": {
          "trigger_code": {
            "type": "string"
          },
          "strategy": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  }
}
