  "design_decisions": [
    {
      "title": "Use external 8MHz HSE",
      "rationale": "Keeps the minimum system suitable for USB-timed firmware and common STM32 examples.",
      "impact": "Adds crystal and two load capacitors."
    },
    {
      "title": "Expose SWD plus NRST",
      "rationale": "Allows firmware flashing and recovery without relying on bootloader pins.",
      "impact": "Uses a compact 5-pin debug header."
    }
  ],
  "risks": [
    "Generated JLC symbols may still need pin-type normalization before using ERC as a fabrication gate."
  ]
