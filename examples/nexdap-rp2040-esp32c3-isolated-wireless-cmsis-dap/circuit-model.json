  "design_decisions": [
    {
      "title": "USB data wired to ESP32-C3",
      "rationale": "ESP32-C3 acts as primary host interface; RP2040 USB is not connected in v1. Wired CMSIS-DAP fallback is through ESP32-C3→SPI→RP2040 path, not direct RP2040 USB.",
      "impact": "USB D+/D- route to ESP32-C3. RP2040 USB_DM/USB_DP pins (36, 37) left unconnected."
    },
    {
      "title": "SPI as primary ESP-RP link, UART as backup",
      "rationale": "SPI provides higher throughput and lower latency for debug transactions. UART retained for recovery and early bring-up.",
      "impact": "ESP32-C3 GPIO4/5/6/10 connected as SPI to RP2040 GPIO10/14/15/11. ESP32-C3 GPIO0/1 wired as UART1 backup to RP2040 GPIO2/3."
    },
    {
      "title": "ESP32-C3 GPIO15 controls RP2040 RUN",
      "rationale": "ESP32-C3 must recover RP2040 without manual intervention. GPIO15 (MTDO) is a non-strap GPIO.",
      "impact": "GPIO15 can pull RP2040 RUN low to reset."
    },
    {
      "title": "ESP32-C3 GPIO21 controls RP2040 BOOTSEL",
      "rationale": "GPIO21 (U0TXD alternate function) used when not needed for serial boot.",
      "impact": "GPIO21 drives RP2040 QSPI_SS/BOOTSEL during reset for flash recovery."
    },
    {
      "title": "RP2040 GPIO4-GPIO5 are SWD lines to target",
      "rationale": "GPIO4/GPIO5 are available after UART is on GPIO2/3.",
      "impact": "SWDIO/SWCLK routed through digital isolator to target connector."
    },
    {
      "title": "ESP32-C3 GPIO17 controls TARGET_PWR_EN",
      "rationale": "GPIO17 (U0RXD) shared — default output low ensures target power off at boot.",
      "impact": "100kΩ pulldown ensures off state before ESP32-C3 configures GPIO."
    },
    {
      "title": "ESP32-C3 strap pins externally biased for SPI boot",
      "rationale": "GPIO2/GPIO8/GPIO9 sampled at CHIP_EN de-assertion. External 10k pull-ups ensure SPI boot (normal).",
      "impact": "GPIO2=RP2040 RUN pullup path provides implicit high. GPIO8=10k pullup. GPIO9=10k pullup (BOOT=1 = normal boot)."
    },
    {
      "title": "SWDIO bidirectional handling via tri-state buffer",
      "rationale": "CA-IS3742HW has fixed-direction channels. SWDIO needs bidirectional path.",
      "impact": "SN74LVC1G125 buffer with RP2040 GPIO18 direction control. Host_SWDIO→buffer→isolator ch1(fwd). Isolator ch4(rev)→host_SWDIO_RX."
    },
    {
      "title": "nRESET uses open-drain NMOS driver",
      "rationale": "Target nRESET may be pulled to different voltage (VTREF). Open-drain allows level-translation.",
      "impact": "2N7002 NMOS: gate from RP2040 GPIO17, drain to target nRESET (pulled up to VTREF on target side), source to GND_HOST."
    },
    {
      "title": "VTREF sensed by ESP32-C3 ADC on GPIO4",
      "rationale": "Before enabling target power or driving SWD, VTREF must be measured.",
      "impact": "10k+10k divider from VTREF to ADC pin. 100nF filter cap for stable reading."
    }
  ],
  "risks": [
    "JLC MCP pin numbers must be verified against the actual installed symbols before netlist generation.",
    "Pin assignments for SPI/UART/GPIO are tentative — verify pin muxing compatibility with RP2040 and ESP32-C3 datasheets.",
    "SWDIO bidirectional isolation with tri-state buffer needs timing validation at target SWD speeds.",
    "Isolated DC-DC 1W power budget: verify total target-side current (isolator + LDO + target 300mA) doesn't exceed 200mA at 5V.",
    "USB data routing to ESP32-C3 means no direct RP2040 USB CMSIS-DAP fallback in v1. Wireless/wired CMSIS-DAP goes through ESP32-C3→SPI→RP2040.",
    "Chip antenna matching network values (L_RF, C_RF_SHUNT) need tuning based on actual PCB layout."
  ]
}