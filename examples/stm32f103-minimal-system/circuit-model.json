  "design_decisions": [
    {
      "title": "STM32F103C8T6 minimum system with USB power",
      "rationale": "Complete minimum system with HSE+LSE crystals, decoupling, SWD programming header, USB-C 5V power input, reset/boot buttons, and indicator LEDs.",
      "impact": "Provides all essential peripherals for STM32 development: clock sources, power regulation, programming interface, and user I/O."
    },
    {
      "title": "USB-C power input with protection",
      "rationale": "USB-C provides 5V VBUS. PTC fuse limits fault current, TVS diode provides ESD protection.",
      "impact": "Protected 5V rail feeds AMS1117-3.3 LDO for 3.3V MCU power."
    },
    {
      "title": "Dual crystal clock sources",
      "rationale": "8MHz HSE for PLL system clock (72MHz max). 32.768kHz LSE for RTC and low-power modes.",
      "impact": "Both crystals included with proper load capacitors."
    },
    {
      "title": "All LCSC Basic Parts for JLCPCB assembly",
      "rationale": "Components selected from JLCPCB Basic Parts catalog for low-cost assembly.",
      "impact": "No extended part fees. All passives in 0603/0805 standard packages."
    }
  ],
  "risks": [
    "STM32F103C8T6 uses KiCad system library symbol MCU_ST_STM32F1:STM32F103C8Tx; verify pin mapping matches actual LQFP-48 pinout.",
