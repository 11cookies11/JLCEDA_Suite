  "design_decisions": [
    {
      "title": "Use bare ESP32-C3 QFN32",
      "rationale": "The user requested a bare-chip ESP32-C3 minimum development board rather than a module.",
      "impact": "Power, EN, BOOT, crystal, USB, UART, and RF antenna connections are explicit in the netlist."
    },
    {
      "title": "Use USB 5V input with local 3V3 regulation",
      "rationale": "USB VBUS provides 5V, while ESP32-C3 core and IO pins require a 3.3V rail.",
      "impact": "The demo includes an LDO placeholder, input/output bulk capacitors, a protected USB 5V rail, and a VBUS TVS clamp."
    },
    {
      "title": "Protect the USB power entry",
      "rationale": "A resettable fuse limits board fault current, while a TVS diode provides a first-pass transient clamp on the 5V input.",
      "impact": "The raw USB VBUS net is separated from the protected +5V_USB net before feeding the LDO."
    }
  ],
  "risks": [
    "ESP32-C3 bare-chip and LDO use local placeholder symbols; replace with verified KiCad symbols before production.",
