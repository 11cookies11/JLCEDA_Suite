  "design_decisions": [
    {
      "title": "Discrete MOSFET H-bridge",
      "rationale": "User requested non-integrated solution using industrial bridge topology. P+N MOSFET pairs with IR2104 gate drivers for each half-bridge.",
      "impact": "Increased component count (8 MOSFETs + 4 gate drivers) but full control over switching characteristics."
    },
    {
      "title": "12V motor supply via USB-C PD",
      "rationale": "USB-C can deliver 5V default; 12V motor rail derived from USB VBUS.  For higher voltages an external supply would be needed.",
      "impact": "Motor voltage limited to 5V with standard USB-C. Components rated for 12V for future upgrade path."
    },
    {
      "title": "Modbus RTU over RS-485",
      "rationale": "Industrial standard for multi-drop serial control. Single UART with DE pin for half-duplex.",
      "impact": "Adds RS-485 transceiver and termination/bias resistors."
    }
  ],
  "risks": [
    "Bootstrap gate drive may fail at very low PWM duty cycles (< 5%)",
    "IR2104S minimum VCC is 10V - need level shifting for 5V operation",
    "GD32F130C8T6 pin compatibility with STM32F103 not guaranteed - verify pinout"
  ],
