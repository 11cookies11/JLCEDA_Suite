  "calculations": [
    {
      "name": "estimated_3v3_load_current",
      "formula": "sum(board_logic, ethernet_phy, usb_hub, sd, display, gpio_bias)",
      "inputs": {
        "board_logic_a": 0.45,
        "ethernet_phy_a": 0.18,
        "usb_hub_a": 0.25,
        "sd_a": 0.08,
        "display_a": 0.12,
        "gpio_bias_a": 0.02
      },
      "result": 1.1,
      "unit": "A"
    },
    {
      "name": "estimated_core_rail_current",
      "formula": "h618_core + lpddr4_core",
      "inputs": {
        "h618_core_a": 1.1,
        "lpddr4_core_a": 0.5
      },
      "result": 1.6,
      "unit": "A"
    },
    {
      "name": "estimated_input_current",
      "formula": "(3v3_power / eff) / 5v_in",
      "inputs": {
        "3v3_power_w": 3.6,
        "efficiency": 0.86,
        "v_in": 5.0
      },
      "result": 0.84,
      "unit": "A"
    },
    {
      "name": "power_margin_percent",
      "formula": "((pmic_limit - estimated_input_current) / pmic_limit) * 100",
      "inputs": {
        "pmic_limit_a": 2.5,
        "estimated_input_current_a": 0.84
      },
      "result": 66.4,
      "unit": "%"
    },
    {
      "name": "usb_c_sink_rd_current_per_cc",
      "formula": "v_cc / r_rd",
      "inputs": {
        "v_cc_v": 5.0,
        "r_rd_ohm": 5100.0
      },
      "result": 0.00098,
      "unit": "A"
    }
  ],
