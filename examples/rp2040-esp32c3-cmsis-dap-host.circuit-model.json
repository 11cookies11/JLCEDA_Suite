  "calculations": [],
  "design_decisions": [
    {
      "title": "ESP32-C3 owns the USB interface",
      "rationale": "The requested USB path is direct to ESP32-C3, so host traffic enters the ESP32-C3 first.",
      "impact": "RP2040 USB pins are intentionally unused in this topology; RP2040 receives work over the ESP/RP UART link."
    },
    {
      "title": "RP2040 is the CMSIS-DAP engine",
      "rationale": "RP2040 has deterministic GPIO timing and runs the DAP firmware role, while ESP32-C3 handles transactions and management.",
      "impact": "RP2040 GPIO2/GPIO3 drive the target SWDIO/SWCLK header."
    },
    {
      "title": "ESP32-C3 supervises RP2040 boot and reset",
      "rationale": "The host MCU needs to recover and reflash the RP2040 without manual intervention.",
      "impact": "ESP32-C3 GPIO2 controls RP2040 RUN, and GPIO8 can pull RP2040 QSPI_SS low for BOOTSEL during reset."
    }
  ],
  "risks": [
    "This is a schematic-generation demo, not a production-ready debug probe reference design.",
    "The RP2040 and ESP32-C3 symbols are local placeholders; verify final pinout against vendor datasheets before PCB layout.",
    "ESP32-C3 GPIO2/GPIO8 strap and boot behavior must be checked before production use as RP2040 control lines.",
    "The target SWD header is simplified to 4 pins and does not include target reset, level shifting, isolation, or target VREF sensing.",
    "The LDO current rating, thermal budget, RF matching, USB-C CC pins, and high-speed USB ESD are placeholders for later engineering refinement."
  ]
