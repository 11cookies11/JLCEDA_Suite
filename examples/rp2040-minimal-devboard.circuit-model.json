  "design_decisions": [
    {
      "title": "Use external QSPI flash",
      "rationale": "RP2040 requires external nonvolatile storage; W25Q-style QSPI flash is represented with a local placeholder symbol.",
      "impact": "Demo exposes QSPI nets explicitly for later footprint and routing refinement."
    },
    {
      "title": "Keep demo schematic minimal",
      "rationale": "The first demo focuses on power, USB data, clock, reset, BOOTSEL, flash, LED, and a small header.",
      "impact": "ESD, USB CC resistors, SWD connector details, and production power-tree details remain follow-up items."
    }
  ],
  "risks": [
    "RP2040 and QSPI flash use local placeholder symbols; replace with verified KiCad library symbols before production.",
    "USB connector is simplified as a 1x04 symbol and does not model USB-C CC pins or ESD protection.",
    "This demo is a schematic-generation smoke artifact, not a production-ready RP2040 reference design."
  ]
